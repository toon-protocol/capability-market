# Kalypso optional prover path — config template (never commit a filled copy).
# The miner touches USDC ONLY. POND / restaked collateral is the prover's slashing
# bond, never the miner's exposure.
#
# These addresses/endpoints are Kalypso-deployment-specific and are NOT published
# in the kalypso-sdk repo — obtain them from a live Kalypso testnet deployment
# (Marlin publishes them per network; the matching-engine URL is an Oyster TEE
# endpoint). Without them the local prover path is used automatically.

# --- chain / wallet ---
KALYPSO_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc   # Kalypso testnet chain RPC
KALYPSO_PRIVATE_KEY=                                       # miner wallet (USDC-funded)
KALYPSO_MARKET_ID=                                         # market registered for image 0x80db88cd…

# --- marketplace + registries (per Kalypso deployment) ---
KALYPSO_PROOF_MARKETPLACE=
KALYPSO_ENTITY_REGISTRY=
KALYPSO_GENERATOR_REGISTRY=
KALYPSO_ATTESTATION_VERIFIER=
KALYPSO_TEE_VERIFIER_DEPLOYER=

# --- tokens ---
KALYPSO_PAYMENT_TOKEN=      # USDC — the reward + MARKET_CREATION_COST token
KALYPSO_STAKING_TOKEN=      # POND — prover collateral (informational; miner never spends it)

# --- enclave / utility endpoints ---
KALYPSO_MATCHING_ENGINE_URL=
KALYPSO_MATCHING_ENGINE_UTILITY_URL=
KALYPSO_CHECK_INPUT_URL=
KALYPSO_ATTESTATION_ENDPOINT=
