# Copy to e2e/.env.devnet (gitignored) and fill in DEPLOYER_KEY.
# Generate a key with `cast wallet new`, then fund it via the devnet faucet:
#   curl -X POST https://faucet.devnet.toonprotocol.dev/api/request \
#     -H 'content-type: application/json' -d '{"address":"0xYOURADDR"}'
DEVNET_RPC_URL=https://evm-rpc.devnet.toonprotocol.dev
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEPLOYER_KEY=0x...
